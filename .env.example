# Copy to the untracked .env file for local Docker Compose development.
# Generate this key once with: openssl rand -base64 32
# Keep the same value across restarts and keep a separate secure backup.
APP_SECRETS_ENCRYPTION_KEY=
APP_SECRETS_PREVIOUS_ENCRYPTION_KEY=

# Optional environment-managed AI configuration. Admin > AI & search can instead
# use a separate encrypted configuration saved through the application.
AI_ENABLED=false
APP_SEARCH_ENABLED=true
APP_SEARCH_LAUNCHER_ENABLED=true
AI_INDEX_CONTENT=false
AI_CHAT_PROVIDER=OPENAI_COMPATIBLE
AI_CHAT_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=
AI_CHAT_API_KEY=
AI_EMBEDDING_PROVIDER=LOCAL
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL=local-feature-hash-v2
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_SEND_DIMENSIONS=true

# Optional outbound email. Admin > Email delivery can instead use its own
# encrypted credentials. PASSWORD accepts SMTP passwords or app passwords.
APP_EMAIL_ENABLED=false
APP_EMAIL_PROVIDER=SMTP
APP_EMAIL_FROM_ADDRESS=
APP_EMAIL_FROM_NAME=
APP_EMAIL_REPLY_TO=
APP_EMAIL_SMTP_HOST=
APP_EMAIL_SMTP_PORT=587
APP_EMAIL_SMTP_SECURITY=STARTTLS
APP_EMAIL_SMTP_AUTH=PASSWORD
APP_EMAIL_SMTP_USERNAME=
APP_EMAIL_SMTP_PASSWORD=
APP_EMAIL_API_BASE_URL=
APP_EMAIL_API_KEY=
APP_EMAIL_MAILGUN_DOMAIN=
