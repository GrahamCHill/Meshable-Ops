# Generate a private local .env with:
# python deploy/github/setup-instance.py --local --admin-email owner@example.com
# This reference file intentionally contains no working passwords or demo accounts.
# Retain existing values across restarts and keep a separate secure backup.
POSTGRES_PASSWORD=
MONGO_PASSWORD=
JWT_SECRET=
SUPERSET_SECRET_KEY=
GUEST_TOKEN_JWT_SECRET=
SUPERSET_ADMIN_PASSWORD=
APP_BOOTSTRAP_USERS_JSON=
MINIO_ROOT_USER=weaveopsdev
MINIO_ROOT_PASSWORD=
AZURITE_ACCOUNT_KEY=
APP_SECRETS_ENCRYPTION_KEY=
APP_SECRETS_PREVIOUS_ENCRYPTION_KEY=

# Optional environment-managed AI configuration. Admin > AI & search can instead
# use a separate encrypted configuration saved through the application.
AI_ENABLED=false
APP_SEARCH_ENABLED=true
APP_SEARCH_LAUNCHER_ENABLED=true
AI_INDEX_CONTENT=false
AI_CHAT_PROVIDER=OPENAI_COMPATIBLE
AI_CHAT_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=
AI_CHAT_API_KEY=
AI_EMBEDDING_PROVIDER=LOCAL
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL=local-feature-hash-v2
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_SEND_DIMENSIONS=true

# Optional outbound email. Admin > Email delivery can instead use its own
# encrypted credentials. PASSWORD accepts SMTP passwords or app passwords.
APP_EMAIL_ENABLED=false
APP_EMAIL_PROVIDER=SMTP
APP_EMAIL_FROM_ADDRESS=
APP_EMAIL_FROM_NAME=
APP_EMAIL_REPLY_TO=
APP_EMAIL_SMTP_HOST=
APP_EMAIL_SMTP_PORT=587
APP_EMAIL_SMTP_SECURITY=STARTTLS
APP_EMAIL_SMTP_AUTH=PASSWORD
APP_EMAIL_SMTP_USERNAME=
APP_EMAIL_SMTP_PASSWORD=
APP_EMAIL_API_BASE_URL=
APP_EMAIL_API_KEY=
APP_EMAIL_MAILGUN_DOMAIN=

# Protected PDF links and incoming webhook URLs; HTTPS origin, no trailing path.
APP_PUBLIC_BASE_URL=
APP_MFA_PRIMARY_ADMIN_EMAIL=admin@app.local
# Opt in only for trusted private network webhook destinations.
APP_WEBHOOK_ALLOW_PRIVATE_TARGETS=false
# Explicit opt-in for trusted self-hosted Git/CalDAV servers on private networks.
APP_PLUGIN_ALLOW_PRIVATE_TARGETS=false
# Private ZIP-backend worker token: generate once, at least 32 characters; retain on updates.
APP_PLUGIN_RUNNER_URL=http://plugin-runner:8090
APP_PLUGIN_RUNNER_TOKEN=

# Internal WeasyCanvas PDF renderer. Native backend development can override its URL.
APP_DOCUMENT_RENDER_URL=http://weasy-renderer:8000
APP_DOCUMENT_RENDER_TOKEN=
