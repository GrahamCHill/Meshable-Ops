FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn dependency:go-offline -q
COPY src/main ./src/main
COPY src/test/kotlin/com/starter/ai ./src/test/kotlin/com/starter/ai
COPY src/test/kotlin/com/starter/security/TestSecrets.kt ./src/test/kotlin/com/starter/security/TestSecrets.kt
COPY src/test/kotlin/com/starter/controller/AdminAiAuthorizationTest.kt ./src/test/kotlin/com/starter/controller/AdminAiAuthorizationTest.kt
COPY src/test/kotlin/com/starter/service/SearchServiceTest.kt ./src/test/kotlin/com/starter/service/SearchServiceTest.kt
RUN mvn package -DskipTests -q
