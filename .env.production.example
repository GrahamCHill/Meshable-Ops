# Copy to .env.production and replace every placeholder before deployment.

JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRY_MS=86400000

SUPERSET_SECRET_KEY=replace-with-a-long-random-superset-secret
GUEST_TOKEN_JWT_SECRET=replace-with-a-long-random-guest-token-secret
SUPERSET_ADMIN_PASSWORD=replace-with-a-strong-superset-admin-password

APP_SEED_ADMIN_EMAIL=admin@example.com
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password

APP_SEED_USER_EMAIL=user@example.com
APP_SEED_USER_USERNAME=user
APP_SEED_USER_PASSWORD=replace-with-a-strong-user-password
