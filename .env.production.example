# Copy to .env.production and replace every placeholder before deployment.

# Public hostname used by Caddy for HTTPS.
# Use only the hostname, with no protocol and no path.
# Good:
#   APP_DOMAIN=app.example.com
#   APP_DOMAIN=analytics.company.com
# Do not use:
#   APP_DOMAIN=https://app.example.com
#   APP_DOMAIN=app.example.com/superset
APP_DOMAIN=app.example.com

# Email address used by Let's Encrypt / ACME for certificate notices.
ACME_EMAIL=admin@example.com

JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRY_MS=86400000

# Backend PostgreSQL connection pool (HikariCP).
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

SUPERSET_SECRET_KEY=replace-with-a-long-random-superset-secret
GUEST_TOKEN_JWT_SECRET=replace-with-a-long-random-guest-token-secret
SUPERSET_ADMIN_PASSWORD=replace-with-a-strong-superset-admin-password

APP_BOOTSTRAP_USERS_JSON=[{"email":"admin@example.com","username":"admin","password":"replace-with-a-strong-admin-password","role":"ADMIN"},{"email":"analyst@example.com","username":"analyst","password":"replace-with-a-strong-analyst-password","role":"USER"}]
