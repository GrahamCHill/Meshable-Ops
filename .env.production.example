# Copy to .env.production and replace every placeholder before deployment.

# Public hostname used by Caddy for HTTPS.
# Use only the hostname, with no protocol and no path.
# Good:
#   APP_DOMAIN=app.example.com
#   APP_DOMAIN=analytics.company.com
# Do not use:
#   APP_DOMAIN=https://app.example.com
#   APP_DOMAIN=app.example.com/superset
APP_DOMAIN=app.example.com

# Email address used by Let's Encrypt / ACME for certificate notices.
ACME_EMAIL=admin@example.com

JWT_SECRET=
POSTGRES_PASSWORD=
MONGO_PASSWORD=
JWT_EXPIRY_MS=86400000

# Required before saving any provider credentials, or upgrading a database with existing keys.
# Generate outside source control: openssl rand -base64 32
APP_SECRETS_ENCRYPTION_KEY=
# For rotation, set the previous key until the startup migration has rewrapped all stored keys.
APP_SECRETS_PREVIOUS_ENCRYPTION_KEY=

# Public app origin used by protected PDF links and incoming webhook URLs.
APP_PUBLIC_BASE_URL=https://app.example.com
# Optional host-managed sign-in providers; see docs/external-login.md for callback URLs.
APP_AUTH_ENTRA_ENABLED=false
APP_AUTH_ENTRA_TENANT_ID=
APP_AUTH_ENTRA_CLIENT_ID=
APP_AUTH_ENTRA_CLIENT_SECRET=
APP_AUTH_GOOGLE_ENABLED=false
APP_AUTH_GOOGLE_CLIENT_ID=
APP_AUTH_GOOGLE_CLIENT_SECRET=
# First-login optional MFA prompt; use the email of your primary admin.
APP_MFA_PRIMARY_ADMIN_EMAIL=admin@example.com
APP_WEBHOOK_ALLOW_PRIVATE_TARGETS=false
APP_DOCUMENT_RENDER_TOKEN=
# Optional SMTP/API email settings are listed in .env.example and docs/email-delivery.md.

# Used while Administration > AI & search selects Environment configuration.
AI_ENABLED=false
APP_SEARCH_ENABLED=true
APP_SEARCH_LAUNCHER_ENABLED=true
AI_INDEX_CONTENT=false
AI_CHAT_PROVIDER=OPENAI_COMPATIBLE
AI_CHAT_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=
AI_CHAT_API_KEY=
AI_EMBEDDING_PROVIDER=LOCAL
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL=local-feature-hash-v3
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_SEND_DIMENSIONS=true

# Backend PostgreSQL connection pool (HikariCP).
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# Optional object-storage bootstrap. These values are persisted in PostgreSQL on
# first startup. Set APP_SEED_STORAGE_FORCE=true only when intentionally replacing
# existing Admin > Storage settings.
APP_SEED_STORAGE_PROVIDER=NONE
APP_SEED_STORAGE_BUCKET=
APP_SEED_STORAGE_REGION=
APP_SEED_STORAGE_ENDPOINT=
APP_SEED_STORAGE_ACCESS_KEY=
APP_SEED_STORAGE_SECRET_KEY=
APP_SEED_STORAGE_ROOT_PATH=contract-management/documents
APP_SEED_STORAGE_FORCE=false

SUPERSET_SECRET_KEY=
GUEST_TOKEN_JWT_SECRET=
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=User

APP_BOOTSTRAP_USERS_JSON=
