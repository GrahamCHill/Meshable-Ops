app.example.com {
    encode gzip zstd
    header >X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"

    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        transport http {
            read_timeout 300s
            write_timeout 300s
        }
    }
}
